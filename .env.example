# GhostGPT Configuration
# Ollama service endpoint (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Model to use for local story generation (default: gemma3:1b)
# Examples: gemma3:1b, llama3.2:1b, mistral, etc.
OLLAMA_MODEL=gemma3:1b

# Request timeout in seconds for story generation
GENERATION_TIMEOUT=90

# Flask server configuration
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FLASK_DEBUG=false
